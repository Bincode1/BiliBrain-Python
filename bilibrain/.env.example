APP_NAME=BiliBrain

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=bilibrain

MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DATABASE=default
MILVUS_COLLECTION=bili_chunks
MILVUS_DIMENSION=1024
TAVILY_API_KEY=
TAVILY_MCP_URL=https://mcp.tavily.com/mcp/

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.5-35b-a3b
ASR_MODEL=qwen3-asr-flash
ASR_LANGUAGE=zh
ASR_CHUNK_SECONDS=120
ASR_TARGET_CHUNK_SECONDS=90
ASR_CHUNK_OVERLAP_SECONDS=1.0
ASR_CHUNK_CONCURRENCY=2
ASR_SILENCE_MIN_SECONDS=0.6
ASR_SILENCE_NOISE_DB=-35.0

OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=bge-m3

BILI_API_DELAY=1.0
AUDIO_STORAGE_PROVIDER=s3
AUDIO_STORAGE_BUCKET=bilibrain-audio
AUDIO_STORAGE_PREFIX=audio
AUDIO_STORAGE_ENDPOINT=http://127.0.0.1:9000
AUDIO_STORAGE_REGION=us-east-1
AUDIO_STORAGE_ACCESS_KEY=minioadmin
AUDIO_STORAGE_SECRET_KEY=minioadmin
AUDIO_STORAGE_PUBLIC_BASE_URL=
AUDIO_STORAGE_PRESIGN_SECONDS=3600
AUDIO_STORAGE_FORCE_PATH_STYLE=true
RAGAS_DATASET_ROOT=datasets
RAGAS_EXPERIMENT_ROOT=experiments
RAGAS_RUN_TIMEOUT_SECONDS=120
RAGAS_RUN_MAX_RETRIES=3
RAGAS_RUN_MAX_WORKERS=4
RAGAS_ENABLE_ANSWER_RELEVANCY=false
TOOLS_ENABLED=false
TOOLS_RUNTIME=local_dev
TOOLS_WORKSPACE_ROOT=data/tool_workspaces
TOOLS_DEFAULT_TIMEOUT_SECONDS=30
TOOLS_MAX_STDOUT_BYTES=65536
TOOLS_MAX_STDERR_BYTES=65536
TOOLS_APPROVAL_REQUIRED_FOR_WRITE=false
TOOLS_APPROVAL_REQUIRED_FOR_COMMAND=false
TOOLS_ALLOWED_COMMAND_PREFIXES=
TOOLS_BLOCKED_COMMAND_PREFIXES=rm;shutdown;reboot;poweroff;mkfs;diskpart;format
TOOLS_DOCKER_BIN=docker
TOOLS_DOCKER_IMAGE=python:3.13-alpine
TOOLS_DOCKER_USER=65532:65532
TOOLS_DOCKER_WORKSPACE_MOUNT_PATH=/workspace
TOOLS_DOCKER_SHELL=/bin/sh
TOOLS_DOCKER_READ_ONLY_ROOTFS=true
TOOLS_DOCKER_NETWORK_DISABLED=true
TOOLS_DOCKER_MEMORY_LIMIT_MB=512
TOOLS_DOCKER_CPU_LIMIT=1.0
TOOLS_DOCKER_PIDS_LIMIT=128
TOOLS_DOCKER_TMPFS_SIZE_MB=64
SKILLS_ENABLED=true
SKILLS_BUILTIN_ROOT=builtin_skills
SKILLS_USER_ROOT=~/.bilibrain/skills
SKILLS_REPO_ROOT=.agents/skills
SKILLS_USER_ENABLED=true
SKILLS_REPO_ENABLED=true
SKILLS_TRUST_REPO=false
SESSION_CACHE_TTL_SECONDS=60
FOLDER_LIST_CACHE_TTL_SECONDS=300
FOLDER_VIDEOS_CACHE_TTL_SECONDS=300
INGESTION_MAX_CONCURRENCY=3
RESET_MAX_CONCURRENCY=4
TRANSCRIPT_MERGE_MAX_GAP=2.0
TRANSCRIPT_MERGE_MAX_DURATION=480.0
TRANSCRIPT_CHUNK_TARGET_CHARS=220
TRANSCRIPT_CHUNK_MIN_CHARS=80
TRANSCRIPT_CHUNK_OVERLAP_CHARS=50
TRANSCRIPT_CHUNK_MAX_TOKENS=600
DEFAULT_MAX_VIDEO_MINUTES=30

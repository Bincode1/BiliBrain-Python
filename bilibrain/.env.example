APP_NAME=BiliBrain

# Data directory (default: ~/BiliBrain_Data)
# DATA_DIR=/path/to/BiliBrain_Data

# Vector store
CHROMA_COLLECTION=bili_chunks
EMBEDDING_DIMENSION=1024

# Model endpoints
# Chat / Embedding / ASR all use the same 3-field contract:
#   *_API_MODEL + *_API_BASE_URL + *_API_KEY

CHAT_API_MODEL=qwen3.5:4b
CHAT_API_BASE_URL=http://127.0.0.1:11434
CHAT_API_KEY=

EMBEDDING_API_MODEL=bge-m3
EMBEDDING_API_BASE_URL=http://127.0.0.1:11434
EMBEDDING_API_KEY=

ASR_API_MODEL=qwen3-asr-flash
ASR_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ASR_API_KEY=
ASR_LANGUAGE=zh
ASR_ENABLE_ITN=false
ASR_API_TIMEOUT_SECONDS=90
ASR_API_RETRIES=2
ASR_API_RETRY_BACKOFF_MILLIS=1000
ASR_CHUNK_SECONDS=120
ASR_TARGET_CHUNK_SECONDS=90
ASR_CHUNK_OVERLAP_SECONDS=1.0
ASR_CHUNK_CONCURRENCY=2
ASR_SILENCE_MIN_SECONDS=0.6
ASR_SILENCE_NOISE_DB=-35.0

# Legacy compatibility only. Prefer the 3 endpoint groups above.
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# EMBEDDING_MODEL=text-embedding-v4
# OLLAMA_BASE_URL=http://127.0.0.1:11434

BILI_API_DELAY=1.0
TOOLS_ENABLED=false
TOOLS_RUNTIME=local_dev
TOOLS_WORKSPACE_ROOT=data/tool_workspaces
TOOLS_DEFAULT_TIMEOUT_SECONDS=30
TOOLS_MAX_STDOUT_BYTES=65536
TOOLS_MAX_STDERR_BYTES=65536
TOOLS_APPROVAL_REQUIRED_FOR_WRITE=false
TOOLS_APPROVAL_REQUIRED_FOR_COMMAND=false
TOOLS_ALLOWED_COMMAND_PREFIXES=
TOOLS_BLOCKED_COMMAND_PREFIXES=rm;shutdown;reboot;poweroff;mkfs;diskpart;format
TOOLS_LOCAL_COMMAND_PREFIXES=
TOOLS_DOCKER_BIN=docker
TOOLS_DOCKER_IMAGE=python:3.13-alpine
TOOLS_DOCKER_USER=65532:65532
TOOLS_DOCKER_WORKSPACE_MOUNT_PATH=/workspace
TOOLS_DOCKER_SHELL=/bin/sh
TOOLS_DOCKER_READ_ONLY_ROOTFS=true
TOOLS_DOCKER_NETWORK_DISABLED=true
TOOLS_DOCKER_MEMORY_LIMIT_MB=512
TOOLS_DOCKER_CPU_LIMIT=1.0
TOOLS_DOCKER_PIDS_LIMIT=128
TOOLS_DOCKER_TMPFS_SIZE_MB=64
SKILLS_ENABLED=true
SKILLS_ROOT=skills
SESSION_CACHE_TTL_SECONDS=60
FOLDER_LIST_CACHE_TTL_SECONDS=300
FOLDER_VIDEOS_CACHE_TTL_SECONDS=300
INGESTION_MAX_CONCURRENCY=3
RESET_MAX_CONCURRENCY=4
TRANSCRIPT_MERGE_MAX_GAP=2.0
TRANSCRIPT_MERGE_MAX_DURATION=480.0
TRANSCRIPT_CHUNK_TARGET_CHARS=220
TRANSCRIPT_CHUNK_MIN_CHARS=80
TRANSCRIPT_CHUNK_OVERLAP_CHARS=50
TRANSCRIPT_CHUNK_MAX_TOKENS=600
DEFAULT_MAX_VIDEO_MINUTES=30
